# ESP-IDF 项目 .gitignore

# 编译产物
/build/
/sdkconfig.old
/sdkconfig
!/sdkconfig.defaults
!/sdkconfig.defaults.*

# 依赖管理
/managed_components/
/dependencies.lock

# Python 虚拟环境
__pycache__/
*.pyc
*.pyo
*.egg-info/

# IDE 配置
.vscode/settings.json
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/tasks.json
.idea/
*.swp
*.swo
*~

# macOS 系统文件
.DS_Store
.AppleDouble
.LSOverride

# 日志文件
*.log

# 临时文件
*.tmp
*.temp

# 二进制/固件文件（如果手动放在项目里）
*.bin
*.elf
*.map

# 备份文件
*.bak
*.orig
