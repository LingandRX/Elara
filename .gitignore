# ESP-IDF 项目 .gitignore

# 编译产物
/build/
/cmake-build-*/
/sdkconfig.old
/sdkconfig
!/sdkconfig.defaults
!/sdkconfig.defaults.*

# 依赖管理
/managed_components/
/dependencies.lock

# LVGL 缓存
*.lv_cache

# LVGL 组件（通过 idf.py add-dependency 安装）
components/lvgl/

# Python 虚拟环境
__pycache__/
*.pyc
*.pyo
*.egg-info/

# IDE / AI 工具本地配置（不纳入版本控制，设备固件不对接任何 AI 编码工具）
.vscode/
.idea/
.codex/
.claude/
.pi/
.opencode/
*.swp
*.swo
*~

# macOS 系统文件
.DS_Store
.AppleDouble
.LSOverride

# 日志文件
*.log

# 临时文件
*.tmp
*.temp

# 二进制/固件文件（如果手动放在项目里）
*.bin
*.elf
*.map

# 备份文件
*.bak
*.orig

/sprites