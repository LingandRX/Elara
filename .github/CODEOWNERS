# 代码所有者配置
# 详见: https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners

# 默认所有者
* @your-github-username

# 显示相关
/main/display/* @your-github-username
/main/input/* @your-github-username

# UI 相关
/main/ui/* @your-github-username
/main/font/* @your-github-username

# 通信相关
/main/comm/* @your-github-username

# 组件库
/components/* @your-github-username

# 文档
/docs/* @your-github-username
*.md @your-github-username

# 配置文件
/.github/* @your-github-username
/CMakeLists.txt @your-github-username
/sdkconfig.defaults @your-github-username
